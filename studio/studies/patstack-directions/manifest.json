{
  "study": "patstack-directions",
  "date": "2026-11-03",
  "status": "owner selected: combination of A1 Rack and A3 Registration",
  "selection": {
    "status": "owner selected",
    "date": "2026-11-03",
    "selected": [
      "a1-rack",
      "a3-registration"
    ],
    "decision": "The owner first narrowed the nine to A1 or A3, both were reviewed with the ui-cliche-audit skill and expanded into a documentation page, a phone version, a terminal session and a poster, and the owner then chose the combination: the A1 Rack system with A3 Registration's plates as the diagram vocabulary.",
    "pack": "../../brands/patstack/GUIDE.md"
  },
  "canvas": "https://claude.ai/artifact/L12uCteNUx37eWSZtmRFDn",
  "audit": [
    {
      "tile": "Both",
      "finding": "Web buttons implied a web app; patstack is a repository and a CLI.",
      "replacement": "Real commands in code blocks and a documentation link."
    },
    {
      "tile": "Both",
      "finding": "The canon defines warning and critical colors with meaning; the tiles showed none.",
      "replacement": "The state set [ACTIVE] [WARNING] [VETO] [ARCHIVE], each mapped to a real installer result."
    },
    {
      "tile": "A1",
      "finding": "The skill card used a left accent stripe, the stock left-border card.",
      "replacement": "A rack unit with ears, slot number and lamp."
    },
    {
      "tile": "A1",
      "finding": "The slot label U01 meant nothing.",
      "replacement": "The rack is the fleet: six hosts with state from the 2026-10-19 deployment record."
    },
    {
      "tile": "A1",
      "finding": "Scanlines were a fashionable texture.",
      "replacement": "Kept on posters only; documentation is undecorated."
    },
    {
      "tile": "A3",
      "finding": "The isometric exploded stack is a stock dev-tool landing motif.",
      "replacement": "Flat misregistered plates for source, plan and installed trees; registration means hashes, modes and symlink targets agree."
    },
    {
      "tile": "A3",
      "finding": "A full violet reading ground tires over a page.",
      "replacement": "Violet field with a paper sheet; documentation reads on paper."
    },
    {
      "tile": "A3",
      "finding": "Acid crosshairs on violet are 3.16:1, decorative only.",
      "replacement": "Ink crosshairs carry the motif at small sizes."
    }
  ],
