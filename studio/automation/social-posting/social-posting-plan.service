[Unit]
Description=Prepare the weekly SUBCULT product social drafts
OnFailure=social-posting-failure.service

[Service]
Type=oneshot
WorkingDirectory=/home/onnwee/Work/Subcult/subcult-tv/studio
ExecStart=/usr/bin/python3 /home/onnwee/Work/Subcult/subcult-tv/studio/automation/social-posting/runner.py plan --refresh
TimeoutStartSec=40min
KillMode=control-group
UMask=0077
Environment=PATH=/home/onnwee/.local/bin:/usr/local/bin:/usr/bin:/bin
UnsetEnvironment=OPENAI_API_KEY CODEX_API_KEY OPENAI_BASE_URL DISPLAY WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP
