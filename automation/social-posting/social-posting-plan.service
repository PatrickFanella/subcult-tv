[Unit]
Description=Prepare the weekly SUBCULT product social drafts
OnFailure=social-posting-failure.service

[Service]
Type=oneshot
WorkingDirectory=/home/onnwee/Documents/ars-malefica
ExecStart=/usr/bin/python3 /home/onnwee/.local/share/social-posting/runner.py plan --refresh
TimeoutStartSec=20min
KillMode=control-group
UMask=0077
Environment=PATH=/home/onnwee/.local/bin:/usr/local/bin:/usr/bin:/bin
UnsetEnvironment=OPENAI_API_KEY CODEX_API_KEY OPENAI_BASE_URL
