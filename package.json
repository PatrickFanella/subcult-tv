{
  "name": "subcult-tv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "subcult.tv — business + portfolio hub for Subculture Collective / SUBCULT",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "tsc -b && npm run generate-rss && npm run generate-sitemap && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,mdx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md,mdx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:catalog": "tsx scripts/check-catalog.ts",
    "generate-rss": "tsx scripts/generate-rss.ts",
    "generate-sitemap": "tsx scripts/generate-sitemap.ts",
    "generate-pdfs": "tsx scripts/generate-pdfs.ts"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "puppeteer": "^24.6.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
